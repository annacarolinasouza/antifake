# ============================================================
# Antifake 2.0 — TUDO funciona sem preencher nada aqui.
# As chaves abaixo são OPCIONAIS e GRATUITAS: só melhoram o texto
# da explicação / acrescentam o banco oficial de checagens.
# ============================================================

# Banco de dados PERMANENTE (recomendado para uso público). Sem isto, usa SQLite local,
# que no plano grátis do Render é apagado quando o servidor reinicia.
# Neon (grátis, não expira): https://neon.tech → copie a "Connection string"
DATABASE_URL=

# Endereço público do site (ativa o "acorda-servidor" e os links de compartilhamento)
PUBLIC_URL=
# Senha para ver as avaliações "resultado errado" em /api/admin/feedback?token=...
ADMIN_TOKEN=
# Limite de verificações por aparelho a cada 10 minutos
RATE_CHECKS=15

# Google Fact Check Tools API (grátis) — banco ClaimReview das agências
# https://console.cloud.google.com/apis/library/factchecktools.googleapis.com
GOOGLE_FACTCHECK_KEY=

# UM destes LLMs (todos têm uso gratuito). Se mais de um, vale a ordem abaixo.
# Gemini — camada gratuita do Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Groq — camada gratuita: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
# Ollama — LLM 100% local no seu computador: https://ollama.com
OLLAMA_URL=
OLLAMA_MODEL=llama3.1

# Transcrição local de vídeo: tiny | base | small (maior = melhor e mais lento)
WHISPER_MODEL=base
VIDEO_MAX_SECONDS=180
MAX_UPLOAD_MB=80

